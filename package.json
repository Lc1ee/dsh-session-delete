  "description": "DSH sidebar session deletion & bulk archive: adds delete-session to session row menus and archive-all/delete-all to workspace row menus",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
